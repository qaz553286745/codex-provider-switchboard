# Copy only the settings you need into your process environment.
SWITCHBOARD_HOST=127.0.0.1
SWITCHBOARD_PORT=8787
# SWITCHBOARD_MAX_REQUEST_BYTES=8388608
# SWITCHBOARD_DEBUG_REQUESTS=1

# Required only for a deliberate non-loopback bind.
# SWITCHBOARD_TOKEN=

# Prefer environment injection when you do not want a file-backed Cursor key.
# CURSOR_API_KEY=

# Local Cursor Agent CLI is the default Cursor backend.
CURSOR_AGENT_CLI=cursor-agent
# CURSOR_CLI_WORKDIR=/tmp/codex-provider-switchboard/cursor-agent
# CURSOR_CLI_MAX_CONCURRENCY=1
# CURSOR_CLI_MAX_PROMPT_BYTES=4194304
# CURSOR_CLI_FIRST_OUTPUT_TIMEOUT_SECONDS=120

# Generic Responses-compatible provider (preferred over file-backed secrets).
# THIRD_PARTY_API_KEY=

# Native direct providers. Environment values override the private credentials
# file; uncomment only the provider you intend to use.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# SWITCHBOARD_DIRECT_MAX_CONCURRENCY=8
# SWITCHBOARD_DIRECT_MAX_OUTPUT_BYTES=67108864
# SWITCHBOARD_OAUTH_TIMEOUT_SECONDS=900
# SWITCHBOARD_OAUTH_CALLBACK_HOST=127.0.0.1

# Test/automation override. Never point tests at your real ~/.codex/config.toml.
# SWITCHBOARD_CODEX_CONFIG=/tmp/codex-switchboard/config.toml

# Redacted rotating history (defaults to the per-user application data dir).
# SWITCHBOARD_LOG_PATH=/tmp/codex-switchboard/logs/switchboard.log
# SWITCHBOARD_LOG_MAX_BYTES=5242880
# SWITCHBOARD_LOG_BACKUP_COUNT=4

KIRO_CLI=kiro-cli
KIRO_MODEL=gpt-5.6-sol
KIRO_SESSION_REUSE=1
# KIRO_MAX_CONCURRENCY=2
# KIRO_QUEUE_TIMEOUT_SECONDS=60
# KIRO_MAX_PROMPT_BYTES=4194304
# KIRO_CONTEXT_RECOVERY_PROMPT_BYTES=786432
